{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "typecheck:tsc": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "format": {},
    "format:check": {}
  }
}
